{
  "name": "@lrclib.js/challenge-solver",
  "description": "A Javascript implementation of the proof-of-work challenge solver for lrclib.net API.",
  "version": "2.0.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla/index.d.ts",
        "default": "./dist/vanilla/index.js"
      }
    },
    "./wasm": {
      "import": {
        "types": "./dist/wasm/index.d.ts",
        "default": "./dist/wasm/index.js"
      }
    },
    "./solver.wasm": {
      "import": "./dist/wasm/wasm.wasm"
    }
  },
  "scripts": {
    "asbuild:debug": "asc --target debug",
    "asbuild": "asc --target release",
    "build": "bun run asbuild && tsdown --config-loader unrun",
    "prepack": "bun run build"
  },
  "files": [
    "dist",
    "build"
  ],
  "dependencies": {
    "@vladfrangu/async_event_emitter": "^2.4.7",
    "assemblyscript": "^0.28.20",
    "uncrypto": "^0.1.3",
    "wasm-crypto": "^0.0.13"
  },
  "devDependencies": {
    "@lrclib.js/api-types": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "bb1d176030b922b5f8681cc5c882d683794987bf"
}
