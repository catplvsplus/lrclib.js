{
  "exclude": ["tsdown.config.ts", "dist", "wasm"],
  "include": ["src", "wasm"],
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": null,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"],
    "paths": {
      "$wasm/*": ["./wasm/*"]
    }
  }
}