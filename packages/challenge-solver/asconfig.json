{
  "entries": [
    "./asc/index.ts"
  ],
  "targets": {
    "debug": {
      "outFile": "wasm/wasm.wasm",
      "textFile": "wasm/wasm.wat",
      "sourceMap": true,
      "debug": true
    },
    "release": {
      "outFile": "wasm/wasm.wasm",
      "textFile": "wasm/wasm.wat",
      "sourceMap": true,
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": false
    }
  },
  "options": {
    "bindings": "raw"
  }
}